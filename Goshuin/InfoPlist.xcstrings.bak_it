    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "紙の御朱印を撮影して、この端末に保存します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take photos of paper goshuin and save them on this device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍摄纸本御朱印并保存到本机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拍攝紙本御朱印並儲存到裝置上。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종이 고슈인을 촬영해 이 기기에 저장합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografía tus goshuin de papel y guárdalos en este dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiere Goshuin auf Papier und sichere sie auf diesem Gerät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photographie tes goshuin papier et enregistre-les sur cet appareil."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografe seus goshuin de papel e salve neste dispositivo."
          }
        }
      }
    }
