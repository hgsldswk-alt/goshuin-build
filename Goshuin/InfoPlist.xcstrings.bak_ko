    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "紙の御朱印を撮影して、この端末に保存します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take photos of paper goshuin and save them on this device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍摄纸本御朱印并保存到本机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拍攝紙本御朱印並儲存到裝置上。"
          }
