    "map.attribution": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地図の出典：国土地理院「地球地図日本」の行政界を簡略化。都道府県庁の位置は Data of Japan。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Map sources: simplified boundaries from GSI Global Map Japan. Prefectural capital locations from Data of Japan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地图来源：日本国土地理院「地球地图日本」行政区划简化。都道府县厅位置来自 Data of Japan。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "地圖來源：日本國土地理院「地球地圖日本」行政區劃簡化。都道府縣廳位置來自 Data of Japan。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지도 출처: 국토지리원 지구지도 일본의 간략 경계. 도도부현청 위치는 Data of Japan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuentes del mapa: límites simplificados del Global Map Japan de GSI. Ubicación de las capitales de prefectura de Data of Japan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartenquellen: vereinfachte Grenzen aus Global Map Japan (GSI). Lage der Präfekturhauptstädte aus Data of Japan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sources de la carte : frontières simplifiées du Global Map Japan (GSI). Emplacement des chefs-lieux de préfecture : Data of Japan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fontes do mapa: limites simplificados do Global Map Japan (GSI). Localização das capitais de província: Data of Japan."
          }
        }
      }
    },
