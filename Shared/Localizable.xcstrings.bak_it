    "purchase.features": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数の冊子と巡礼を追加。写真の一括取込、見開き分割、日付・寺社の一括編集、選んだページの書き出し。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create extra books and routes. Import in batches, split spreads, batch-edit dates or places, and export selected pages."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新建额外的册与路线，批量导入、拆分双页、批量修改日期或寺社、导出所选册页。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增額外的冊與路線，批次匯入、拆分雙頁、批次修改日期或寺社、匯出所選冊頁。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수첩과 경로를 더 만드세요. 한꺼번에 가져오고, 펼친 면을 나누고, 날짜나 장소를 일괄 편집하고, 선택한 페이지를 내보낼 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea libros y rutas extra. Importa por lotes, divide páginas dobles, edita fechas o lugares en lote y exporta páginas seleccionadas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle zusätzliche Bücher und Routen. Importiere stapelweise, teile Doppelseiten, bearbeite Daten oder Orte gesammelt und exportiere ausgewählte Seiten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée des carnets et itinéraires supplémentaires. Importe par lot, divise les doubles pages, modifie dates ou lieux par lot et exporte les pages sélectionnées."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie cadernos e roteiros extras. Importe em lote, divida páginas duplas, edite datas ou lugares em lote e exporte páginas selecionadas."
          }
        }
      }
    },
    "purchase.free": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存のページと巡礼は引き続き閲覧・編集できます。撮影、検索、参拝の記録、バックアップも無料です。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep viewing and editing your pages and routes. Capture, search, mark visits and back up your journal for free."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有册页与路线可继续查看和编辑。拍摄、检索、打卡和备份永久免费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已有冊頁與路線可繼續查看和編輯。拍攝、搜尋、打卡和備份永久免費。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페이지와 경로는 계속 보고 편집할 수 있습니다. 촬영, 검색, 방문 표시, 수첩 백업은 무료입니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue viendo y editando tus páginas y rutas. Fotografía, busca, marca visitas y haz copias de tu diario gratis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh und bearbeite deine Seiten und Routen weiterhin. Fotografieren, suchen, Besuche markieren und dein Tagebuch sichern bleibt kostenlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue de voir et modifier tes pages et itinéraires. Photographier, chercher, marquer les visites et sauvegarder ton journal reste gratuit."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue vendo e editando suas páginas e roteiros. Fotografar, buscar, marcar visitas e fazer backup do diário é grátis."
          }
        }
      }
    },
    "purchase.none": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元できる購入情報はありませんでした。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No purchases were available to restore."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可恢复的购买记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有可回復的購買紀錄。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복원할 구매가 없습니다."
