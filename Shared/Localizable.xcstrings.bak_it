    "backup.help": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "原本の写真、冊子、寺社と巡礼をまとめて「ファイル」に保存できます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save original photos, books, places and routes together in Files."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将原图、册页、寺社和巡礼一起保存到“文件”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將原圖、冊頁、寺社和巡禮一起儲存到「檔案」。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 사진, 수첩, 장소, 경로를 파일 앱에 함께 저장합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda juntas en Archivos las fotos originales, libros, lugares y rutas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Originalfotos, Bücher, Orte und Routen gemeinsam in „Dateien“ sichern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre ensemble dans Fichiers les photos originales, carnets, lieux et itinéraires."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve juntos em Arquivos as fotos originais, cadernos, lugares e roteiros."
          }
        }
      }
    },
    "backup.merge": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容が異なる同じIDの項目は、両方を残します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When items share an ID and differ, both copies are kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同 ID 但内容不同的项目会保留两份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同 ID 但內容不同的項目會保留兩份。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ID가 같고 내용이 다르면 두 사본을 모두 남깁니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si dos elementos comparten ID y son distintos, se conservan ambas copias."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Haben Einträge dieselbe ID, unterscheiden sich aber, werden beide Kopien behalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si deux éléments ont le même ID mais diffèrent, les deux copies sont conservées."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando itens têm o mesmo ID e são diferentes, as duas cópias são mantidas."
          }
        }
      }
    },
