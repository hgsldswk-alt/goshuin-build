    "route.sharePrivacy": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有するのは表示中の名前と地域です。位置情報、進捗や写真は含まれません。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the names and regions shown here are shared. Pins, progress and photos stay on your device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅分享预览中的名称和地区。位置、进度和照片留在本机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅分享預覽中的名稱和地區。位置、進度和照片留在裝置上。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기 보이는 이름과 지역만 공유됩니다. 핀, 진행, 사진은 기기에 남습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se comparten los nombres y regiones mostrados. Los marcadores, el progreso y las fotos se quedan en tu dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die angezeigten Namen und Regionen werden geteilt. Pins, Fortschritt und Fotos bleiben auf deinem Gerät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les noms et régions affichés sont partagés. Les épingles, la progression et les photos restent sur ton appareil."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só os nomes e regiões mostrados são compartilhados. Marcadores, progresso e fotos ficam no seu dispositivo."
          }
        }
      }
    },
