    "share.privacy": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置と詳しい日付は表示しません。写真に個人情報が写っていないか確認してください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pins and exact dates stay hidden. Check the photos for personal details before sharing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置和具体日期默认不展示。分享前请检查照片中是否拍到个人信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "位置和確切日期預設不顯示。分享前請檢查照片中是否拍到個人資訊。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "핀과 정확한 날짜는 숨겨집니다. 공유 전에 사진에 개인 정보가 없는지 확인하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los marcadores y fechas exactas se ocultan. Revisa las fotos por si tienen datos personales antes de compartir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pins und genaue Daten bleiben verborgen. Prüfe die Fotos vor dem Teilen auf persönliche Angaben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les épingles et dates exactes restent masquées. Vérifie que les photos ne contiennent pas d’infos personnelles avant de partager."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcadores e datas exatas ficam ocultos. Verifique se as fotos não têm dados pessoais antes de compartilhar."
          }
        }
      }
    },
