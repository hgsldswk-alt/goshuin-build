    "purchase.claimDetail": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初回起動から30日間。既に経過した日数は変わりません。終了後、複数の冊子や巡礼、一括整理を続けて使うには買い切り（%@）が必要です。自動請求はありません。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The trial lasts 30 days from first launch. Claiming this receipt does not restart it. A one-time purchase (%@) unlocks extra books, routes and batch tools afterward. No automatic charge."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从首次打开起试用 30 天，领取凭证不会重置期限。到期后新建额外册和路线、使用批量工具需买断（%@）。不会自动扣费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從首次開啟起試用 30 天，領取憑證不會重設期限。到期後新增額外冊和路線、使用批次工具需買斷（%@）。不會自動扣款。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체험은 처음 실행한 날부터 30일입니다. 이 영수증을 받아도 다시 시작되지 않습니다. 이후 한 번 구매(%@)로 추가 수첩, 경로, 일괄 도구가 열립니다. 자동 결제는 없습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La prueba dura 30 días desde el primer uso. Obtener este recibo no la reinicia. Después, una compra única (%@) desbloquea libros extra, rutas y herramientas por lotes. Sin cobros automáticos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Test läuft 30 Tage ab dem ersten Start. Dieser Beleg startet ihn nicht neu. Danach schaltet ein Einmalkauf (%@) zusätzliche Bücher, Routen und Stapelwerkzeuge frei. Keine automatische Abbuchung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’essai dure 30 jours dès le premier lancement. Obtenir ce reçu ne le relance pas. Ensuite, un achat unique (%@) débloque carnets supplémentaires, itinéraires et outils par lot. Aucun paiement automatique."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O teste dura 30 dias desde a primeira abertura. Obter este recibo não o reinicia. Depois, uma compra única (%@) desbloqueia cadernos extras, roteiros e ferramentas em lote. Sem cobrança automática."
          }
        }
      }
    },
