    "privacy.body": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真と記録はこの端末に保存されます。アカウント、広告、利用状況の収集はありません。購入は App Store が処理します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos and records stay on this device. There are no accounts, ads or analytics. Purchases are handled by the App Store."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片和记录保存在本机。无账号、广告或使用统计。购买由 App Store 处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片和紀錄儲存在裝置上。無帳號、廣告或使用統計。購買由 App Store 處理。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진과 기록은 이 기기에만 남습니다. 계정, 광고, 분석이 없습니다. 구매는 App Store가 처리합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos y registros se quedan en este dispositivo. Sin cuentas, anuncios ni analíticas. Las compras las gestiona el App Store."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos und Einträge bleiben auf diesem Gerät. Keine Konten, keine Werbung, keine Analysen. Käufe laufen über den App Store."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos et notes restent sur cet appareil. Pas de compte, de publicité ni d’analyse. Les achats sont gérés par l’App Store."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos e registros ficam neste dispositivo. Sem contas, anúncios ou análises. As compras são feitas pela App Store."
          }
        }
      }
    },
