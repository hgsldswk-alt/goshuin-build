        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片和记录保存在本机。无账号、广告或使用统计。购买由 App Store 处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
