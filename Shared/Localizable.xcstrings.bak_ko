    "purchase.features": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数の冊子と巡礼を追加。写真の一括取込、見開き分割、日付・寺社の一括編集、選んだページの書き出し。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create extra books and routes. Import in batches, split spreads, batch-edit dates or places, and export selected pages."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新建额外的册与路线，批量导入、拆分双页、批量修改日期或寺社、导出所选册页。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增額外的冊與路線，批次匯入、拆分雙頁、批次修改日期或寺社、匯出所選冊頁。"
          }
        }
      }
    },
    "purchase.free": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存のページと巡礼は引き続き閲覧・編集できます。撮影、検索、参拝の記録、バックアップも無料です。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep viewing and editing your pages and routes. Capture, search, mark visits and back up your journal for free."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有册页与路线可继续查看和编辑。拍摄、检索、打卡和备份永久免费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已有冊頁與路線可繼續查看和編輯。拍攝、搜尋、打卡和備份永久免費。"
          }
        }
      }
    },
