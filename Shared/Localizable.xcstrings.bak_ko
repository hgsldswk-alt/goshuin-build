    "purchase.claimDetail": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初回起動から30日間。既に経過した日数は変わりません。終了後、複数の冊子や巡礼、一括整理を続けて使うには買い切り（%@）が必要です。自動請求はありません。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The trial lasts 30 days from first launch. Claiming this receipt does not restart it. A one-time purchase (%@) unlocks extra books, routes and batch tools afterward. No automatic charge."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从首次打开起试用 30 天，领取凭证不会重置期限。到期后新建额外册和路线、使用批量工具需买断（%@）。不会自动扣费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從首次開啟起試用 30 天，領取憑證不會重設期限。到期後新增額外冊和路線、使用批次工具需買斷（%@）。不會自動扣款。"
          }
        }
      }
    },
