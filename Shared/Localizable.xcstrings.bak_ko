    "privacy.body": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真と記録はこの端末に保存されます。アカウント、広告、利用状況の収集はありません。購入は App Store が処理します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos and records stay on this device. There are no accounts, ads or analytics. Purchases are handled by the App Store."
